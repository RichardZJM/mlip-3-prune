#!/bin/bash
#
# MLIP configure script

# output file for config makefile.
MKFILE=make/config.mk

# Defaults
prefix=.
debug=
mpi=0
compiler=gnu
blas=
blasroot=
public=
selftest=1
extra=
heavytests=
cxxflag=

# halt
Halt() { echo -e "Error: $*" 1>&2; exit 1; }

# check installed package
Check() { which ${1} 2> /dev/null; }

# usage output function
Usage() 
{
  echo $header
  cat >&1 <<EndUsage 
Usage: ./configure [options]
Options:
  --prefix=<path>              installation prefix
  --no-mpi                     disable MPI libraries [autodetect]
  --no-selftest                disable selftest implementation
  --heavytests                 include heavy shell tests
  --enable-debug               include debug symbols [no]
  --compiler=[intel|gnu]       which compilers to use [autodetect]
  --blas=[mkl|openblas]        BLAS/LAPACK library [autodetect]
  --blas-root=<path>           Path to OpenBLAS (if not in standard path)
EndUsage
  exit 1
}

echo "Starting autodetection..."

# autodetect mpi support
if Check mpicc; then
    mpi=1
    echo "  -- MPI: Found mpicc. MPI support enabled."
else
    echo "  -- MPI: mpicc not found. MPI support disabled."
fi

# autodetect compiler and blas/lapack library
if [ -n "${MKLROOT}" ]; then
    compiler="intel"
    blas=mkl
    echo "  -- BLAS/LAPACK: Intel MKL detected via MKLROOT (${MKLROOT})"
elif [ -f /usr/include/openblas/cblas.h ] || [ -f /usr/local/include/openblas/cblas.h ] || [ -f /usr/include/x86_64-linux-gnu/openblas/cblas.h ]; then
    blas=openblas
    echo "  -- BLAS/LAPACK: OpenBLAS detected in system paths."
else
    echo "  -- BLAS/LAPACK: No high-performance library detected automatically."
fi

# LP64 or non-LP64 for the Intel MKL
arch=$(arch)
if [[ "${arch}" == i386 || "${arch}" == i486 || "${arch}" == i586 || "${arch}" == i686 ]]; then
  arch_lp64=0
else
  arch_lp64=1
fi

# options
for arg in "$@"; do
    case "${arg}" in
    --prefix=* )
        prefix=$(echo $arg | sed 's/--prefix=//') ;;
    --no-mpi )
        mpi=0 ;;
    --no-selftest )
        selftest=0 ;;
    --enable-debug )
        debug=1 ;;
    --compiler=* )
        compiler=$(echo $arg | sed 's/--compiler=//') ;;
    --blas=*)
        blas=$(echo $arg | sed 's/--blas=//') ;;
    --blas-root=* )
        blasroot=$(echo $arg | sed 's/--blas-root=//') ;;
    --heavytests )
        heavytests=1 ;;
    --help )
        Usage ;;

    * ) Halt "unknown option - \"$arg\"." ;;
    esac
done

# Force requirement check
if [[ "${blas}" != "mkl" && "${blas}" != "openblas" ]]; then
    Halt "High-performance BLAS/LAPACK is REQUIRED for performance (dposv/dgesv support).\nAutodetection failed and no valid library was specified.\nPlease install OpenBLAS or Intel MKL."
fi

# Verbosity: Summary of important user/detected inputs
echo ""
echo "Configuration Summary:"
echo "  Compiler:    ${compiler}"
echo "  MPI:         $( [ $mpi -eq 1 ] && echo "Enabled" || echo "Disabled" )"
echo "  Math Lib:    ${blas} (provides BLAS + LAPACK)"
if [ "${blas}" == "openblas" ] && [ -n "${blasroot}" ]; then
    echo "  Lib Path:    ${blasroot}"
fi
echo "  Optimizations: -O3 -march=native"
echo ""

echo 'Generating makefile configuration ...'

cat > ${MKFILE} <<MKEOF
# Directories
PREFIX = $prefix
BIN_DIR = \$(PREFIX)/bin
OBJ_DIR = \$(PREFIX)/obj
LIB_DIR = \$(PREFIX)/lib
MKEOF

if [ "${debug}" == 1 ]; then
  debugflag="-DDEBUG -g"
fi

case "${compiler}" in
    intel )
        echo "" >> ${MKFILE}
        echo "# MPI Compilers" >> ${MKFILE}
        if [ $mpi = 1 ]; then
            echo "CC_MPI  = mpiicc" >> ${MKFILE}
            echo "CXX_MPI = mpiicpc" >> ${MKFILE}
            echo "FC_MPI  = mpiifort" >> ${MKFILE}
        fi
        echo "" >> ${MKFILE}
        echo "# Serial Compilers" >> ${MKFILE}
        echo "CC  = icc" >> ${MKFILE}
        echo "CXX = icpc" >> ${MKFILE}
        echo "FC  = ifort" >> ${MKFILE}
        if [ $mpi = 1 ]; then
            CC="mpiicc"; CXX="mpiicpc"
        else
            CC="icc"; CXX="icpc"
        fi
        ;;
    gnu )
        echo "" >> ${MKFILE}
        echo "# MPI Compilers" >> ${MKFILE}
        if [ $mpi = 1 ]; then
            fc=mpif90;
            test $(Check mpifc) && fc=mpifc
            echo "CC_MPI  = mpicc" >> ${MKFILE}
            echo "CXX_MPI = mpicxx" >> ${MKFILE}
            echo "FC_MPI  = ${fc}" >> ${MKFILE}
        fi
        echo "" >> ${MKFILE}
        echo "# Serial Compilers" >> ${MKFILE}
        echo "CC  = gcc" >> ${MKFILE}
        echo "CXX = g++" >> ${MKFILE}
        echo "FC  = gfortran" >> ${MKFILE}
        if [ $mpi = 1 ]; then
            CC="mpicc"; CXX="mpicxx"
        else
            CC="gcc"; CXX="g++"
        fi
        ;;
    * ) Halt "unknown compiler \"${compiler}\"." ;;
esac

echo "" >> ${MKFILE}
echo "# Compile and link flags" >> ${MKFILE}
echo "CPPFLAGS += ${debugflag}" >> ${MKFILE}
# Forced march=native ensures the compiler uses the best vector instructions for LAPACK/BLAS
echo "CXXFLAGS += -O3 -std=c++11 -fPIC -march=native" >> ${MKFILE}
echo "CCFLAGS += -O3 -fPIC -march=native" >> ${MKFILE}
echo "FFLAGS += -O3 -fPIC -march=native ${debugflag}" >> ${MKFILE}

if [ "${mpi}" == 1 ]; then
	echo "CPPFLAGS_MPI += -DMLIP_MPI" >> ${MKFILE}
	echo "USE_MPI = 1" >> ${MKFILE}
else 
	echo "USE_MPI = 0" >> ${MKFILE}
fi

if [ "${selftest}" == 0 ]; then
	cxxflag+=" -DMLIP_NO_SELFTEST" 
fi

if [ -n "${cxxflag}" ]; then
  echo "CXXFLAGS +=${cxxflag}" >> ${MKFILE}
fi

case "${compiler}" in
    intel )
        linklib="-lifcore"
        ;;
    gnu )
        linklib="-lgfortran"
        ;;
esac

case "${blas}" in
    mkl ) 
        if [[ "${arch_lp64}" = 1 ]]; then
            mkllib="intel64"
        else
            mkllib="ia32"
        fi
	echo "" >> ${MKFILE}
	echo "# Flags for compilation using MKL (includes LAPACK)" >> ${MKFILE}
        echo "LDFLAGS += -L${MKLROOT}/lib/${mkllib} -lmkl_rt ${linklib}" >> ${MKFILE}
        echo "CPPFLAGS += -I${MKLROOT}/include" >> ${MKFILE}
        echo "CXXFLAGS += -DMLIP_INTEL_MKL " >> ${MKFILE}
        ;;
    openblas )
	echo "" >> ${MKFILE}
	echo "# Flags for compilation using OpenBLAS + LAPACK" >> ${MKFILE}
        if [ -n "${blasroot}" ]; then
            # Explicitly adding -llapack to ensure dposv etc. are found
            echo "LDFLAGS += -L${blasroot}/lib -lopenblas -llapack ${linklib}" >> ${MKFILE}
            echo "CPPFLAGS += -I${blasroot}/include" >> ${MKFILE}
        else
            echo "LDFLAGS += -lopenblas -llapack ${linklib}" >> ${MKFILE}
        fi
        ;;
    * ) Halt "unknown BLAS library name \"${blas}\"." ;;
esac

echo "" >> ${MKFILE}
echo 'Configuration complete.'