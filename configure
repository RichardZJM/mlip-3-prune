#!/bin/bash
#
# MLIP configure script

# output file for config makefile.
MKFILE=make/config.mk

# Defaults
prefix=.
debug=
mpi=0
compiler=gnu
blas=
blasroot=
public=
selftest=1
extra=
heavytests=
cxxflag=

# halt
Halt() { echo -e "Error: $*" 1>&2; exit 1; }

# check installed package
Check() { which ${1} 2> /dev/null; }

# usage output function
Usage() 
{
  echo $header
  cat >&1 <<EndUsage 
Usage: ./configure [options]
Options:
  --prefix=<path>              installation prefix
  --no-mpi                     disable MPI libraries [autodetect]
  --no-selftest                disable selftest implementation
  --heavytests                 include heavy shell tests
  --enable-debug               include debug symbols [no]
  --compiler=[intel|gnu]       which compilers to use [autodetect]
  --blas=NAME                  BLAS/LAPACK library [autodetect]
  --blas-root=<path>           Path to OpenBLAS (if not in standard path)
BLAS option names:
  mkl                          Intel MKL library
  openblas                     OpenBLAS library
EndUsage
  exit 1
}

echo "Starting autodetection..."

# autodetect mpi support
if Check mpicc; then
    mpi=1
    echo "  -- MPI: Found mpicc. MPI support enabled."
else
    echo "  -- MPI: mpicc not found. MPI support disabled."
fi

# autodetect compiler and blas/lapack library
if [ -n "${MKLROOT}" ]; then
    compiler="intel"
    blas=mkl
    echo "  -- Compiler:    Intel (icc/icpc detected via MKLROOT)"
    echo "  -- BLAS/LAPACK: Intel MKL detected via MKLROOT (${MKLROOT})"

# Check common module-set env vars for OpenBLAS
elif [ -n "${OPENBLAS_ROOT}" ]; then
    blas=openblas
    blasroot="${OPENBLAS_ROOT}"
    echo "  -- BLAS/LAPACK: OpenBLAS detected via OPENBLAS_ROOT (${blasroot})"
elif [ -n "${OPENBLAS_DIR}" ]; then
    blas=openblas
    blasroot="${OPENBLAS_DIR}"
    echo "  -- BLAS/LAPACK: OpenBLAS detected via OPENBLAS_DIR (${blasroot})"
elif [ -n "${OPENBLAS_HOME}" ]; then
    blas=openblas
    blasroot="${OPENBLAS_HOME}"
    echo "  -- BLAS/LAPACK: OpenBLAS detected via OPENBLAS_HOME (${blasroot})"

# Scan CPATH for openblas (set by module load)
elif echo "${CPATH}" | tr ':' '\n' | grep -qi openblas; then
    blasroot=$(echo "${CPATH}" | tr ':' '\n' | grep -i openblas | head -1 | sed 's|/include.*||')
    blas=openblas
    echo "  -- BLAS/LAPACK: OpenBLAS detected via CPATH (${blasroot})"

# Scan LIBRARY_PATH for openblas (set by module load)
elif echo "${LIBRARY_PATH}" | tr ':' '\n' | grep -qi openblas; then
    blasroot=$(echo "${LIBRARY_PATH}" | tr ':' '\n' | grep -i openblas | head -1 | sed 's|/lib.*||')
    blas=openblas
    echo "  -- BLAS/LAPACK: OpenBLAS detected via LIBRARY_PATH (${blasroot})"

# Hardcoded system paths as last resort
elif [ -f /usr/include/openblas/cblas.h ] || \
     [ -f /usr/local/include/openblas/cblas.h ] || \
     [ -f /usr/include/x86_64-linux-gnu/openblas/cblas.h ]; then
    blas=openblas
    echo "  -- BLAS/LAPACK: OpenBLAS detected in system paths."
else
    echo "  -- BLAS/LAPACK: No high-performance library detected automatically."
fi

# LP64 or non-LP64 for the Intel MKL
arch=$(arch)
if [[ "${arch}" == i386 || "${arch}" == i486 || "${arch}" == i586 || "${arch}" == i686 ]]; then
  arch_lp64=0
else
  arch_lp64=1
fi

# options
for arg in "$@"; do
    case "${arg}" in
    --prefix=* )
        prefix=$(echo $arg | sed 's/--prefix=//') ;;
    --no-mpi )
        mpi=0 ;;
    --no-selftest )
        selftest=0 ;;
    --enable-debug )
        debug=1 ;;
    --compiler=* )
        compiler=$(echo $arg | sed 's/--compiler=//') ;;
    --blas=*)
        blas=$(echo $arg | sed 's/--blas=//') ;;
    --blas-root=* )
        blasroot=$(echo $arg | sed 's/--blas-root=//') ;;
    --heavytests )
        heavytests=1 ;;
    --help )
        Usage ;;
    * ) Halt "unknown option - \"$arg\"." ;;
    esac
done

# Force requirement check
if [[ "${blas}" != "mkl" && "${blas}" != "openblas" ]]; then
    Halt "High-performance BLAS/LAPACK is REQUIRED (dposv/dgesv support).\nAutodetection failed and no valid library was specified.\nPlease install OpenBLAS or Intel MKL, or use 'module load openblas'.\nIf your module sets a non-standard env var, use --blas=openblas --blas-root=<path>."
fi

# Configuration summary
echo ""
echo "Configuration Summary:"
echo "  Compiler:    ${compiler}"
echo "  MPI:         $( [ $mpi -eq 1 ] && echo "Enabled" || echo "Disabled" )"
echo "  Math Lib:    ${blas} (provides BLAS + LAPACK)"
if [ "${blas}" == "openblas" ] && [ -n "${blasroot}" ]; then
    echo "  Lib Path:    ${blasroot}"
fi
echo ""

echo 'Generating makefile configuration ...'

cat > ${MKFILE} <<MKEOF
# Directories
PREFIX = $prefix
BIN_DIR = \$(PREFIX)/bin
OBJ_DIR = \$(PREFIX)/obj
LIB_DIR = \$(PREFIX)/lib
MKEOF

if [ "${debug}" == 1 ]; then
  debugflag="-DDEBUG -g"
fi

case "${compiler}" in
    intel )
        echo "" >> ${MKFILE}
        echo "# MPI Compilers" >> ${MKFILE}
        if [ $mpi = 1 ]; then
            echo "CC_MPI  = mpiicc #for C" >> ${MKFILE}
            echo "CXX_MPI = mpiicpc #for C++" >> ${MKFILE}
            echo "FC_MPI  = mpiifort #for fortran" >> ${MKFILE}
        fi
        echo "" >> ${MKFILE}
        echo "# Serial Compilers" >> ${MKFILE}
        echo "CC  = icc #for C" >> ${MKFILE}
        echo "CXX = icpc #for C++" >> ${MKFILE}
        echo "FC  = ifort #for fortran" >> ${MKFILE}
        if [ $mpi = 1 ]; then
            CC="mpiicc"
            CXX="mpiicpc"
        else
            CC="icc"
            CXX="icpc"
        fi
        ;;
    gnu )
        echo "" >> ${MKFILE}
        echo "# MPI Compilers" >> ${MKFILE}
        if [ $mpi = 1 ]; then
            fc=mpif90;
            test $(Check mpifc) && fc=mpifc
            echo "CC_MPI  = mpicc  #for C" >> ${MKFILE}
            echo "CXX_MPI = mpicxx  #for C++" >> ${MKFILE}
            echo "FC_MPI  = ${fc}  #for fortran" >> ${MKFILE}
        fi
        echo "" >> ${MKFILE}
        echo "# Serial Compilers" >> ${MKFILE}
        echo "CC  = gcc  #for C" >> ${MKFILE}
        echo "CXX = g++  #for C++" >> ${MKFILE}
        echo "FC  = gfortran #for fortran" >> ${MKFILE}
        if [ $mpi = 1 ]; then
            CC="mpicc"
            CXX="mpicxx"
        else
            CC="gcc"
            CXX="g++"
        fi
        ;;
    * ) Halt "unknown compiler \"${compiler}\"." ;;
esac

echo "" >> ${MKFILE}
echo "# Compile and link flags" >> ${MKFILE}
echo "# CPPFLAGS are preprocessor flags" >> ${MKFILE}
echo "# CXXFLAGS are c++ compiler flags" >> ${MKFILE}
echo "# CCFLAGS are c compiler flags" >> ${MKFILE}
echo "# FFLAGS are flags for fortran compiler" >> ${MKFILE}
echo "# LDFLAGS are flags for linker" >> ${MKFILE}
echo "CPPFLAGS += ${debugflag}" >> ${MKFILE}
echo "CXXFLAGS += -O3 -std=c++11 -fPIC -march=native" >> ${MKFILE}
echo "CCFLAGS += -O3 -fPIC -march=native" >> ${MKFILE}
echo "FFLAGS += -O3 -fPIC -march=native ${debugflag}" >> ${MKFILE}

if [ "${mpi}" == 1 ]; then
	echo "# Flag for mpi preprocessor" >> ${MKFILE}
	echo "CPPFLAGS_MPI += -DMLIP_MPI" >> ${MKFILE}
fi

echo "# Flag for compilation of developer version" >> ${MKFILE}
if [ "${mpi}" == 1 ]; then
	echo "# Compile mpi version" >> ${MKFILE}
	echo "USE_MPI = 1" >> ${MKFILE}
else 
	echo "# Compile mpi version" >> ${MKFILE}
	echo "USE_MPI = 0" >> ${MKFILE}
fi

if [ "${selftest}" == 0 ]; then
	echo "# No running of test suite" >> ${MKFILE}
	cxxflag+=" -DMLIP_NO_SELFTEST"
fi

if [ "${heavytests}" == 1 ]; then
        echo "# Run heavy shell tests" >> ${MKFILE}
        echo "RUN_HEAVY_TESTS = 1" >> ${MKFILE}
fi

if [ -n "${cxxflag}" ]; then
  echo "CXXFLAGS +=${cxxflag}" >> ${MKFILE}
fi

case "${compiler}" in
    intel )
        linklib="-lifcore"
        pythonlibs="ifcore"
        ;;
    gnu )
        linklib="-lgfortran"
        pythonlibs="gfortran"
        ;;
esac

case "${blas}" in
    mkl ) 
        if [[ "${arch_lp64}" = 1 ]]; then
            mkllib="intel64"
        else
            mkllib="ia32"
        fi
	echo "" >> ${MKFILE}
	echo "# Flags for compilation using MKL BLAS" >> ${MKFILE}
        echo "LDFLAGS += -L${MKLROOT}/lib/${mkllib} -lmkl_rt ${linklib}" >> ${MKFILE}
        echo "CPPFLAGS += -I${MKLROOT}/include" >> ${MKFILE}
        echo "CXXFLAGS += -DMLIP_INTEL_MKL " >> ${MKFILE}
        pythonlibs+=" mkl_rt"
        pythonlibdir="${MKLROOT}/lib/${mkllib}"
        pythonincdir="${MKLROOT}/include"
        ;;
    openblas )
	echo "" >> ${MKFILE}
	echo "# Flags for compilation using OpenBLAS (includes LAPACK)" >> ${MKFILE}
        if [ -n "${blasroot}" ]; then
            # HPC-installed OpenBLAS (e.g. ComputeCanada) bundles LAPACK inside libopenblas.
            # Only add -llapack if a separate liblapack actually exists in the lib dir.
            if ls "${blasroot}"/lib/liblapack.* &>/dev/null; then
                lapacklib="-llapack"
            else
                lapacklib=""
                echo "  (Note: no separate liblapack in ${blasroot}/lib -- OpenBLAS assumed to bundle LAPACK)"
            fi
            echo "LDFLAGS += -L${blasroot}/lib -lopenblas ${lapacklib} ${linklib}" >> ${MKFILE}
            echo "CPPFLAGS += -I${blasroot}/include" >> ${MKFILE}
            pythonlibs+=" openblas"
            pythonlibdir="${blasroot}/lib"
            pythonincdir="${blasroot}/include"
        else
            echo "LDFLAGS += -lopenblas -llapack ${linklib}" >> ${MKFILE}
            pythonlibs+=" openblas"
            pythonlibdir=""
            pythonincdir=""
        fi
        ;;
    * ) Halt "unknown BLAS library name \"${blas}\"." ;;
esac

echo "" >> ${MKFILE}
echo 'Configuration complete.'
